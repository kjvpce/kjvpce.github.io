{
  "name": "King James Bible Pure Cambridge Edition",
  "short_name": "KJV PCE",
  "description": "King James Version (1611) with verse-by-verse read-aloud. 英王欽定本聖經。",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#fbf8f3",
  "theme_color": "#7a3b1e",
  "lang": "en",
  "icons": [
